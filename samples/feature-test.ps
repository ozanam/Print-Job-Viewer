% indexed colour image
gsave 50 160 translate 200 100 scale
[/Indexed /DeviceRGB 3 <FF0000 00FF00 0000FF FFFF00>] setcolorspace
<< /ImageType 1 /Width 4 /Height 2 /BitsPerComponent 8 /Decode [0 255] /ImageMatrix [4 0 0 -2 0 2]
   /DataSource <0001020303020100> >> image
grestore
% tiling pattern
<< /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 20 20] /XStep 20 /YStep 20
   /PaintProc { pop 1 0 0 setrgbcolor 0 0 10 10 rectfill 0 0 1 setrgbcolor 10 10 10 10 rectfill } >> matrix makepattern
/P exch def
gsave P setpattern 300 160 245 100 rectfill grestore
% rotated text
gsave 300 100 translate 20 rotate /Helvetica findfont 18 scalefont setfont 0 0 moveto (Rotated 20 degrees) show grestore
% stdout message
(Hello from PostScript) =
showpage
%%Page: 2 2
<< /PageSize [842 595] >> setpagedevice
/Helvetica findfont 40 scalefont setfont
421 500 moveto (Page 2 - A4 landscape) cshow
/Symbol findfont 24 scalefont setfont 100 400 moveto (abgdp) show
/ZapfDingbats findfont 24 scalefont setfont 100 350 moveto (3456) show
0.5 setgray 100 100 642 50 rectfill
/Helvetica findfont 20 scalefont setfont 1 setgray 120 115 moveto (White text on grey) show
showpage
%%Trailer
%%EOF
