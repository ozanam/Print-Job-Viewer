%!PS-Adobe-3.0
%%Title: PostScript feature test
%%Creator: hand written
%%For: tester
%%Pages: 2
%%DocumentMedia: A4 595 842 0 () ()
%%LanguageLevel: 3
%%EndComments
%%BeginProlog
/cshow { dup stringwidth pop 2 div neg 0 rmoveto show } bind def
%%EndProlog
%%BeginSetup
%%BeginFeature: *PageSize A4
<< /PageSize [595 842] >> setpagedevice
%%EndFeature
%%BeginFeature: *Duplex DuplexNoTumble
<< /Duplex true /Tumble false >> setpagedevice
%%EndFeature
<< /NumCopies 3 >> setpagedevice
%%EndSetup
%%Page: 1 1
/Helvetica-Bold findfont 28 scalefont setfont
297 790 moveto (PostScript feature test) cshow
/Times-Roman findfont dup length dict begin { 1 index /FID ne { def } { pop pop } ifelse } forall
 /Encoding ISOLatin1Encoding def currentdict end /Times-ISO exch definefont pop
/Times-ISO findfont 14 scalefont setfont
50 750 moveto (Re-encoded Times: \351t\351, na\357ve, \374ber, \243 5) show
/Courier findfont 12 scalefont setfont
50 730 moveto 2 0 (ashow spacing) ashow
50 712 moveto { pop pop 3 0 rmoveto } (kshow kerned) kshow
% Type 3 font
8 dict begin
/FontType 3 def /FontMatrix [.001 0 0 .001 0 0] def /FontBBox [0 0 1000 1000] def
/Encoding 256 array def 0 1 255 { Encoding exch /.notdef put } for
Encoding 97 /square put Encoding 98 /circle put
/CharProcs 3 dict def
CharProcs begin
/.notdef {} def
/square { 0 0 moveto 800 0 lineto 800 800 lineto 0 800 lineto closepath fill } def
/circle { 400 400 400 0 360 arc fill } def
end
/BuildGlyph { 1000 0 0 0 1000 1000 setcachedevice exch /CharProcs get exch 2 copy known not { pop /.notdef } if get exec } def
/BuildChar { 1 index /Encoding get exch get 1 index /BuildGlyph get exec } def
currentdict end /Shapes exch definefont pop
/Shapes findfont 20 scalefont setfont
0 0.5 0 setrgbcolor
50 680 moveto (ababab) show
0 setgray
% vector graphics
newpath 100 560 60 0 360 arc closepath gsave 1 0 0 setrgbcolor fill grestore 4 setlinewidth stroke
gsave 0 0 1 setrgbcolor 200 500 120 120 rectfill grestore
gsave 0.2 0.6 0.2 0.1 setcmykcolor 360 500 moveto 420 620 lineto 480 500 lineto closepath fill grestore
gsave [10 5] 0 setdash 2 setlinewidth 50 480 moveto 545 480 lineto stroke grestore
% clipping
gsave 400 360 moveto 0 0 0 setrgbcolor 400 360 70 0 360 arc clip
 1 0.5 0 setrgbcolor 0 10 200 { 330 add 290 exch 4 140 rectfill } for
 newpath 330 290 moveto 470 430 lineto 8 setlinewidth 0 0 1 setrgbcolor stroke
grestore
% inline hex image (gray 8x8 checker)
gsave 50 300 translate 120 120 scale
8 8 8 [8 0 0 -8 0 8] {<
00FF00FF00FF00FF FF00FF00FF00FF00 00FF00FF00FF00FF FF00FF00FF00FF00
00FF00FF00FF00FF FF00FF00FF00FF00 00FF00FF00FF00FF FF00FF00FF00FF00>} image
grestore
% imagemask with colour
gsave 200 300 translate 100 100 scale 0.8 0 0.8 setrgbcolor
16 16 true [16 0 0 -16 0 16] {<FFFF8001BFFDA005A7E5A425A5A5A5A5A5A5A425A7E5A005BFFD8001FFFF0000>} imagemask
grestore
% Flate + ASCII85 colour image via dictionary
gsave 330 300 translate 200 100 scale
/DeviceRGB setcolorspace
<< /ImageType 1 /Width 64 /Height 32 /BitsPerComponent 8 /Decode [0 1 0 1 0 1]
   /ImageMatrix [64 0 0 -32 0 32] /DataSource currentfile /ASCII85Decode filter /FlateDecode filter >> image
